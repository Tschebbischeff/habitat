# This file contains environment variables for the build-context.
# It is also passed into the deployment container.
# Required at build time:
PROJECT_NAME="${PROJECT_NAME:-habitat-deploy}"
NETWORK_POOL="${NETWORK_POOL:-172.31.0.0/16}"
MODULE_DEPLOY_PATH="${MODULE_DEPLOY_PATH:-$PWD/habitat-modules}"
MODULE_LIST="${MODULE_LIST:-path,scent,vista}"
MODULE_ENV_FILE="${MODULE_ENV_FILE:-./_.env}"
# Required within the deployment container:
RUN_AS_USER="${RUN_AS_USER:-}"
RUN_AS_GROUP="${RUN_AS_GROUP:-}"
UPDATE_MODULES="${UPDATE_MODULES:-yes}"
UPGRADE_MODULES="${UPGRADE_MODULES:-yes}"
UPGRADE_MODULES_FORCE_BUILD="${UPGRADE_MODULES_FORCE_BUILD:-no}"
UPGRADE_MODULES_SEQUENTIAL="${UPGRADE_MODULES_SEQUENTIAL:-no}"
SHUTDOWN_TIMEOUT="${SHUTDOWN_TIMEOUT:-60}"