#!/usr/bin/env bash

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/include/._source"


# ### Guard Clauses

{
    [ -f "$HABITAT_RUN_DIR/APP_SESSION_ID.txt" ] && \
    HABITAT_APP_SESSION_ID="$(cat "$HABITAT_RUN_DIR/APP_SESSION_ID.txt")";
} || { echo "No APP_SESSION_ID found."; exit 1; }


# ### Includes

include parseModuleInfo
include updateOrInitModule
include upgradeModule
include startModule
include parseArgs


# ### Args

parseArgs "$@"
ARGS_HOTSWAP="$(getFlagExists hotswap)"
ARGS_UPDATE="$(getFlagExists update)"
ARGS_UPGRADE="$(getFlagExists upgrade)"
declare -a ARGS_MODULES=("${ARGS_POSITIONAL[@]}")

[ -n "$ARGS_HOTSWAP" ] && ARGS_UPDATE="_"


# ### Exit function

exitImmediately() {
    trap - SIGTERM
    [[ -v "2" ]] && [ -n "$2" ] && echo "$2"
    [[ -v "1" ]] && exit "$1"
    exit 0
}
# shellcheck disable=SC2329  # Gets used in trap
onTerminate() {
    trap '' SIGTERM
    echo "Exiting... Cleaning up..."
    [ -f "$HABITAT_RUN_DIR/.restarting" ] && rm "$HABITAT_RUN_DIR/.restarting"
    echo "Stopping background tasks..."
    # shellcheck disable=SC2046 # Word splitting intentional
    kill $(jobs -p)
    echo "All background tasks stopped."
    exitImmediately 0 "Goodbye."
}
trap onTerminate SIGTERM


# ### Init

parseModuleInfo "$MODULE_LIST"
# shellcheck disable=SC2155  # Return value is of no interest
export HABITAT_APP_MODULES="$(printf ',%s' "${!MODULE_REPOS[@]}" | grep -Po '^,\K.*')"
# shellcheck disable=SC2155  # Return value is of no interest
export HABITAT_APP_SESSION_ID="$(cat "/proc/sys/kernel/random/uuid")"


# ### Clone and/or Update modules

if [ -n "$ARGS_UPDATE" ]; then
    updateOrInitModules "$MODULE_DEPLOY_PATH" "$UPDATE_MODULES" "${ARGS_MODULES[@]}" || {
        echo "Some updates or initializations failed, see logs above."
        exit 1
    }
fi


# ### Pull and build if needed and/ or enabled

if [ -n "$ARGS_UPGRADE" ]; then
    upgradeModules "$MODULE_DEPLOY_PATH" "$UPGRADE_MODULES" "$UPGRADE_MODULES_FORCE_BUILD" "$UPGRADE_MODULES_SEQUENTIAL" "${ARGS_MODULES[@]}" || {
        echo "Some pull and/ or build operations failed, see logs above."
        exit 1
    }
fi


# ### Start modules

date +%s >"$HABITAT_RUN_DIR/.restarting"
startModules "$MODULE_DEPLOY_PATH" "${ARGS_MODULES[@]}" || {
    echo "Some start operations failed, see logs above."
    exit 1
}
rm "$HABITAT_RUN_DIR/.restarting"

exitImmediately