#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Public Variables

declare -gA ARGS_FLAGS
declare -ga ARGS_POSITIONAL


# Public Functions

parseArgs() {
    # Vars
    local argName argValue
    # Body
    while [ "$#" -gt "0" ]; do
        [ "$1" == "--" ] && shift && break
        if [[ "$1" =~ ^-.* ]]; then
            # Flags
            argName="${1#-}"
            argName="${argName#-}"
            argValue="${argName#*=}"
            argName="${argName%%=*}"
            # shellcheck disable=SC2034  # Scoped outside included function
            ARGS_FLAGS[$argName]="$argValue"
        else
            # Positional arguments
            ARGS_POSITIONAL+=("$1")
            { [ -z "$appname" ] && { appname="$1"; true; } } ||
            { :; }
        fi
        shift
    done
}

getFlagExists() {
    # Args
    local flagName trueValue falseValue
    flagName="$1"; shift
    trueValue="${1:-_}"; shift
    falseValue="${1:-}"; shift
    # Body
    { [[ -v "ARGS_FLAGS[$flagName]" ]] && echo "$trueValue"; } || echo "$falseValue"
}

getFlagValue() {
    # Args
    local flagName defaultValue noneValue
    flagName="$1"; shift
    defaultValue="${1:-}"; shift
    noneValue="${1:-}"; shift
    # Body
    if [[ -v "ARGS_FLAGS[$flagName]" ]]; then
        { [ -z "${ARGS_FLAGS[$flagName]}" ] && echo "${ARGS_FLAGS[$flagName]}"; } || echo "$noneValue"
    else
        echo "$defaultValue"
    fi
}