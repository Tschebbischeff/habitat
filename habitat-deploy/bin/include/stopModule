#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"

# Include other Modules

include prepEnvironment
include parseModuleInfo

# Public Functions

stopModule() {
    # Args
    local moduleWorkdir moduleName shutdownTimeout
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    shutdownTimeout="$1"; shift
    # Vars
    local moduleDir
    moduleDir="${MODULE_DIRS[$moduleName]}"
    # Body
    (
        cd "$moduleWorkdir"
        prepEnvironment "$moduleName"
        runningServices="$(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            ps \
                --no-trunc \
                --format "{{.ID}} {{.Name}}"
        )"
        if [ -z "$runningServices" ]; then
            echo "'$moduleName' already stopped."
            exit 0
        fi
        echo "Stopping '$moduleName' (Timeout: ${shutdownTimeout}s)..."
        docker compose \
            -f "./$moduleDir/compose.yml" \
        down \
            --timeout "$shutdownTimeout" \
        &>/dev/null
    ) || return "$?"
    return 0
}

stopAllModules() {
    # Args
    local moduleWorkdir shutdownTimeout
    moduleWorkdir="$1"; shift
    shutdownTimeout="$1"; shift
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    exitCode="0"
    # Body
    for moduleName in "${!MODULE_DIRS[@]}"; do
        stopModule "$moduleWorkdir" "$moduleName" "$shutdownTimeout" &
        moduleByPID[$!]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in $(jobs -p); do
        wait "$jobPID" || {
            echo "Stopping '${moduleByPID[$jobPID]}' failed with exit code '$?'."
            exitCode="1"
        }
    done
    return "$exitCode"
}