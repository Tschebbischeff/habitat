#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include prepEnvironment
include parseModuleInfo


# Public Functions

waitExitModule() {
    # Args
    local moduleWorkdir moduleName restartTimeout
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    restartTimeout="$1"; shift
    # Vars
    local moduleDir
    declare -A containerIdToName
    moduleDir="${MODULE_DIRS[$moduleName]:-}"
    [ -n "$moduleDir" ] || { echo "Missing metadata for module '$moduleName'."; return 1; }
    # Body
    (
        cd "$moduleWorkdir"
        prepEnvironment "$moduleName"
        while read -r id name; do
            [ -n "$id" ] && [ -n "$name" ] && containerIdToName["$id"]="$name"
        done < <(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            ps \
                -a \
                --no-trunc \
                --format "{{.ID}} {{.Name}}"
        )
        exitCode="0"
        exitedOnce=""
        restartUltimatum="$(date +%s)"
        restartUltimatum="$(( restartUltimatum + restartTimeout ))"
        while [ "$(date +%s)" -lt "$restartUltimatum" ]; do
            runningServices=""
            while [ "$(date +%s)" -lt "$restartUltimatum" ] && [ -z "$runningServices" ]; do
                # shellcheck disable=SC2046 # Word splitting intentional
                runningServices="$(
                    docker compose \
                        -f "./$moduleDir/compose.yml" \
                        --progress plain \
                    ps \
                        --no-trunc \
                        --format "{{.ID}} {{.Name}}" \
                    $(
                        docker compose \
                            -f "./$moduleDir/compose.yml" \
                            --progress plain \
                        config --services
                    )
                )"
            done
            [ -z "$runningServices" ] && {
                if [ -z "$exitedOnce" ]; then
                    echo "'$moduleName' did not start within the time limit."
                else
                    echo "'$moduleName' did not restart within the time limit."
                fi
                continue
            }
            if [ -z "$exitedOnce" ]; then
                echo "Waiting for '$moduleName' to exit..."
            else
                echo "'$moduleName' restarted, waiting for it to exit again..."
            fi
            # shellcheck disable=SC2046 # Word splitting intentional
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            wait $(
                docker compose \
                    -f "./$moduleDir/compose.yml" \
                    --progress plain \
                config --services
            ) | while read -r line; do
                for id in "${!containerIdToName[@]}"; do
                    line="${line//\"$id\"/\"$id\" (${containerIdToName[$id]})}"
                done
                echo "$line"
            done
            exitCode="$?"
            exitedOnce="_"
            timeout="$restartTimeout"
            if [ -f "$HABITAT_RUN_DIR/.restarting" ]; then
                timeout="300"
                echo "Hotswap detected, waiting ${timeout}s for '$moduleName' to restart..."
            else
                echo "Waiting ${timeout}s for '$moduleName' to restart..."
            fi
            restartUltimatum="$(date +%s)"
            restartUltimatum="$(( restartUltimatum + timeout ))"
            unset timeout
        done
        exit "$exitCode"
    ) || return "$?"
    return 0
}

waitExitModules() {
    # Args
    local moduleWorkdir restartTimeout
    moduleWorkdir="$1"; shift
    restartTimeout="$1"; shift
    declare -a moduleList
    while [ "$#" -gt 0 ]; do
        [ "$1" == "--" ] && break
        moduleList+=("$1")
        shift
    done
    if [[ ! -v "moduleList" ]]; then
        moduleList=("${!MODULE_DIRS[@]}")
    fi
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    exitCode="0"
    # Body
    echo "Waiting for modules to exit: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
    for moduleName in "${moduleList[@]}"; do
        waitExitModule "$moduleWorkdir" "$moduleName" "$restartTimeout" &
        moduleByPID[$!]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in "${!moduleByPID[@]}"; do
        wait "$jobPID" || {
            echo "Module '${moduleByPID[$jobPID]}' exited with exit code '$?'."
            exitCode="1"
        }
    done
    return "$exitCode"
}