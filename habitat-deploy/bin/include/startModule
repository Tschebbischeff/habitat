#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[ -n "${HABITAT_INCLUDE["__main__"]}" ] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[ -n "${HABITAT_INCLUDE["$(basename "${BASH_SOURCE[0]}")"]}" ] && return 0
HABITAT_INCLUDE["$(basename "${BASH_SOURCE[0]}")"]="_"
echo "Loading '$(basename "${BASH_SOURCE[0]}")'..."

# Include other Modules

include prepEnvironment "$@"
include parseModuleInfo "$@"

# Public Functions

startModule() {
    # Args
    local moduleName
    moduleName="$1"; shift
    # Vars
    local moduleDir
    moduleDir="${MODULE_DIRS[$moduleName]}"
    # Body
    (
        prepEnvironment "$moduleName"
        echo "Starting '$moduleName' ..."
        docker compose \
            -f "./$moduleDir/compose.yml" \
            --progress plain \
        up \
            --pull never \
            --no-build \
            -d \
        2> >(grep -Pv '^.*level=warning msg="(Found orphan containers.*|secret file .* does not exist)"$' >&2)
        exit "$?"
    )
    return "$?"
}

startAllModules() {
    # Vars
    local allSuccess moduleName jobPID
    declare -A moduleByPID
    allSuccess="_"
    # Body
    for moduleName in "${!MODULE_DIRS[@]}"; do
        startModule "$moduleName" &
        moduleByPID["$!"]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in $(jobs -p); do
        wait "$jobPID"
        exitCode="$?"
        [ "$exitCode" -eq 0 ] || {
            echo "Starting '${moduleByPID["$jobPID"]}' failed with exit code '$exitCode'."
            allSuccess=""
        }
    done
    [ -n "$allSuccess" ] || exit 1
}