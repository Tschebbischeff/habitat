#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[ -n "${HABITAT_INCLUDE["__main__"]}" ] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[ -n "${HABITAT_INCLUDE["$(basename "${BASH_SOURCE[0]}")"]}" ] && return 0
HABITAT_INCLUDE["$(basename "${BASH_SOURCE[0]}")"]="_"
echo "Loading '$(basename "${BASH_SOURCE[0]}")'..."

# Public Variables

STATUS_FILE="$1"; shift
[ -f "$STATUS_FILE" ] || exit 1

# Public Functions

setContainerStatus() {
    echo "$1" >"$STATUS_FILE"
}