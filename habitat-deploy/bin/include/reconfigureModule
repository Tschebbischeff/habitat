#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include prepEnvironment
include parseModuleInfo


# Constants

START_LOG_BLACKLIST="$(cat <<EOF | sed -E ':a; N; $!ba; s/\n//g'
^.*(
level=warning msg="(Found orphan containers.*|secret file .* does not exist)"
|
Network ${HABITAT_APP_NAME_HOST}_internal Error Error response from daemon: network with name ${HABITAT_APP_NAME_HOST}_internal already exists
)$
EOF
)"

# Public Functions

reconfigureModule() {
    # Args
    local moduleWorkdir moduleName sessionId
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    { [[ -v "1" ]] && sessionId="$1"; } || sessionId="$(cat "$HABITAT_RUN_DIR/APP_SESSION_ID.txt")"
    # Vars
    local moduleDir
    moduleDir="${MODULE_DIRS[$moduleName]:-}"
    [ -n "$moduleDir" ] || { echo "Missing metadata for module '$moduleName'."; return 1; }
    # Body
    (
        cd "$moduleWorkdir"
        prepEnvironment "$moduleName"
        export APP_SESSION_ID="$sessionId"
        echo "Reconfiguring '$moduleName' ..."
        docker compose \
            -f "./$moduleDir/compose.yml" \
            --progress plain \
        up \
            --pull never \
            --no-build \
            -d \
        "habitat-config-$moduleName" \
        2> >(grep -Pv "$START_LOG_BLACKLIST" >&2)
        exit "$?"
    ) || return "$?"
    return 0
}

reconfigureModules() {
    # Args
    local moduleWorkdir
    moduleWorkdir="$1"; shift
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    declare -a moduleList
    exitCode="0"
    moduleList=("${!MODULE_DIRS[@]}")
    # Body
    echo "Reconfiguring modules: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
    for moduleName in "${moduleList[@]}"; do
        reconfigureModule "$moduleWorkdir" "$moduleName" "$(cat "/proc/sys/kernel/random/uuid")" &
        moduleByPID[$!]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in "${!moduleByPID[@]}"; do
        wait "$jobPID" || {
            echo "Reconfiguring '${moduleByPID[$jobPID]}' failed with exit code '$?'."
            exitCode="1"
        }
    done
    return "$exitCode"
}