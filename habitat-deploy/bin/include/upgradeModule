#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include prepEnvironment
include parseModuleInfo
include updateOrInitModule


# Public Functions

upgradeModule() {
    # Args
    local moduleWorkdir moduleName upgradeAllowed forceBuild
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    upgradeAllowed="$1"; shift
    forceBuild="$1"; shift
    # Vars
    local moduleDir moduleUpdated imageHashesBefore imageHashesAfter
    moduleDir="${MODULE_DIRS[$moduleName]:-}"
    moduleUpdated="${MODULE_UPDATED[$moduleName]:-}"
    [ -n "$moduleDir" ] || { echo "Missing metadata for module '$moduleName'."; return 1; }
    # Body
    (
        cd "$moduleWorkdir"
        prepEnvironment "$moduleName"
        [ "$upgradeAllowed" == "yes" ] \
            && echo "Pulling latest images for '$moduleName'..." \
            || echo "Pulling missing images for '$moduleName'..."
        imageHashesBefore="$(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            config \
                --images \
            2>/dev/null | sort | xargs -r docker image inspect --format '{{.Id}}' 2>/dev/null || true
        )"
        if docker compose \
            -f "./$moduleDir/compose.yml" \
            --progress plain \
        pull \
            --policy "$([ "$upgradeAllowed" == "yes" ] && echo "always" || echo "missing")"
        then
            imageHashesAfter="$(
                docker compose \
                    -f "./$moduleDir/compose.yml" \
                    --progress plain \
                config \
                    --images \
                2>/dev/null | sort | xargs -r docker image inspect --format '{{.Id}}' 2>/dev/null || true
            )"
            if [ "$forceBuild" == "yes" ] || [ "$imageHashesBefore" != "$imageHashesAfter" ] || [ -n "$moduleUpdated" ]; then
                echo "Building $([ "$forceBuild" == "yes" ] && echo "(forced) ")'$moduleName'..."
                docker compose \
                    -f "./$moduleDir/compose.yml" \
                    --progress plain \
                build
            else
                echo "No updates in module repository or images, running everything from local caches."
            fi
        fi
    ) || return "$?"
    return 0
}

upgradeModules() {
    # Args
    local moduleWorkdir upgradeAllowed forceBuild sequentialMode
    moduleWorkdir="$1"; shift
    upgradeAllowed="$1"; shift
    forceBuild="$1"; shift
    sequentialMode="$1"; shift
    declare -a moduleList
    while [ "$#" -gt 0 ]; do
        [ "$1" == "--" ] && break
        moduleList+=("$1")
        shift
    done
    if [ "${#moduleList[@]}" -eq 0 ]; then
        moduleList=("${!MODULE_DIRS[@]}")
    fi
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    exitCode="0"
    # Body
    echo "Upgrading modules: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
    for moduleName in "${moduleList[@]}"; do
        upgradeModule "$moduleWorkdir" "$moduleName" "$upgradeAllowed" "$forceBuild" &
        jobPID="$!"
        moduleByPID[$jobPID]="$moduleName"
        if [ "$sequentialMode" == "yes" ]; then
            wait "$jobPID" || {
                echo "Upgrading '${moduleByPID["$jobPID"]}' failed with exit code '$?'."
                exitCode="1"
                break
            }
        fi
    done
    if [ "$sequentialMode" != "yes" ]; then
        # shellcheck disable=SC2046 # Word splitting intentional
        for jobPID in "${!moduleByPID[@]}"; do
            wait "$jobPID" || {
                echo "Upgrading '${moduleByPID[$jobPID]}' failed with exit code '$?'."
                exitCode="1"
            }
        done
    fi
    return "$exitCode"
}