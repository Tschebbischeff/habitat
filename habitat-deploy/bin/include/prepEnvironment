#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include parseModuleInfo


# Public Functions

clearDeploymentEnvironment() {
    # Body
    unset "PROJECT_NAME"
    unset "NETWORK_POOL"
    unset "MODULE_DEPLOY_PATH"
    unset "MODULE_LIST"
    unset "MODULE_ENV_FILE"
    unset "RUN_AS_USER"
    unset "RUN_AS_GROUP"
    unset "UPDATE_MODULES"
    unset "UPGRADE_MODULES"
    unset "UPGRADE_MODULES_FORCE_BUILD"
    unset "UPGRADE_MODULES_SEQUENTIAL"
    unset "SHUTDOWN_TIMEOUT"
}

exportSharedEnvironment() {
    # Body
    # shellcheck disable=SC2155  # Return value is of no interest
    export HABITAT_APP_MODULES="$(printf ',%s' "${!MODULE_REPOS[@]}" | grep -Po '^,\K.*')"
    [ -f "$HABITAT_RUN_DIR/APP_SESSION_ID.txt" ] || cat "/proc/sys/kernel/random/uuid" >"$HABITAT_RUN_DIR/APP_SESSION_ID.txt"
    # shellcheck disable=SC2155  # Return value is of no interest
    export HABITAT_APP_SESSION_ID="$(cat "$HABITAT_RUN_DIR/APP_SESSION_ID.txt")"
    while IFS='=' read -r -d '' n v; do
        if echo "$n" | grep -q '^HABITAT_'; then
            echo "$n" | grep -q '^HABITAT_MODULE_' && continue
            export "${n#"HABITAT_"}"="$v"
            unset -v "$n"
        fi
    done < <(env -0)
}

exportModuleEnvironment() {
    # Args
    local moduleNameUpper
    moduleNameUpper="${1^^}"
    # Body
    while IFS='=' read -r -d '' n v; do
        if echo "$n" | grep -q '^HABITAT_MODULE_'; then
            if echo "$n" | grep -q "^HABITAT_MODULE_${moduleNameUpper}_"; then
                export "${n#"HABITAT_MODULE_${moduleNameUpper}_"}"="$v"
            fi
            unset -v "$n"
        fi
    done < <(env -0)
}

prepEnvironment() {
    # WARNING: Side-effects will modify environment, only call from within subshell
    # Args
    local moduleName
    moduleName="$1"
    # Body
    exportSharedEnvironment
    [ -n "$moduleName" ] && exportModuleEnvironment "$moduleName"
    clearDeploymentEnvironment
}