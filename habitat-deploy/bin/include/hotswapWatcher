#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include prepEnvironment
include parseModuleInfo


# Public Variables

HOTSWAP_WATCHER_PID=""


# Public Functions

startHotswapWatcher() {
    # Args
    local moduleWorkdir
    moduleWorkdir="$1"; shift
    declare -a moduleList
    while [ "$#" -gt 0 ]; do
        [ "$1" == "--" ] && break
        moduleList+=("$1")
        shift
    done
    if [[ ! -v "moduleList" ]]; then
        for moduleName in "${!MODULE_HOTSWAP_ENABLED[@]}"; do
            [ -n "$moduleName" ] && [ "${MODULE_HOTSWAP_ENABLED[$moduleName]}" == "yes" ] && \
                moduleList+=("$moduleName")
        done
    fi
    # Vars
    local moduleDir
    declare -a composeArgs serviceNames
    # Body
    [[ -v "moduleList" ]] || return 0
    [ -z "$HOTSWAP_WATCHER_PID" ] || return 1
    for moduleName in "${moduleList[@]}"; do
        moduleDir="${MODULE_DIRS[$moduleName]:-}"
        serviceNames+=(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            config --services
        )
        composeArgs+=("-f" "./$moduleDir/compose.yml")
    done
    (
        cd "$moduleWorkdir"
        prepEnvironment ""
        echo "Starting watcher for modules: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
        # shellcheck disable=SC2046 # Word splitting intentional
        docker compose \
            "${composeArgs[@]}" \
            --progress plain \
        watch \
            --no-up --quiet \
            "${serviceNames[@]}" \
        || true
        # | while read -r line; do
        #     {
        #         [ "$line" == "none of the selected services is configured for watch, consider setting a 'develop' section" ];
        #     } && continue
        #     echo "$line"
        # done || true
        echo "Stopped watcher for modules: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
    ) &
    HOTSWAP_WATCHER_PID="$!"
    return 0
}

stopHotswapWatcher() {
    # Body
    [ -n "$HOTSWAP_WATCHER_PID" ] || return 1
    { kill "$HOTSWAP_WATCHER_PID" && wait "$HOTSWAP_WATCHER_PID"; } || true
    HOTSWAP_WATCHER_PID=""
    return 0
}