#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"

# Include other Modules

include prepEnvironment
include parseModuleInfo

# Public Functions

waitForModuleExit() {
    # Args
    local moduleWorkdir moduleName
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    # Vars
    local moduleDir
    declare -A containerIdToName
    moduleDir="${MODULE_DIRS[$moduleName]}"
    # Body
    (
        cd "$moduleWorkdir"
        prepEnvironment "$moduleName"
        echo "Waiting for '$moduleName' to exit..."
        while read -r id name; do
            [ -n "$id" ] && [ -n "$name" ] && containerIdToName["$id"]="$name"
        done < <(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            ps \
                -a \
                --no-trunc \
                --format "{{.ID}} {{.Name}}"
        )
        # shellcheck disable=SC2046 # Word splitting intentional
        docker compose \
            -f "./$moduleDir/compose.yml" \
            --progress plain \
        wait $(
            docker compose \
                -f "./$moduleDir/compose.yml" \
                --progress plain \
            config --services
        ) | while read -r line; do
            for id in "${!containerIdToName[@]}"; do
                line="${line//\"$id\"/\"$id\" (${containerIdToName[$id]})}"
            done
            echo "$line"
        done
        exit "$?"
    ) || return "$?"
    return 0
}

waitForAllModulesExit() {
    # Args
    local moduleWorkdir
    moduleWorkdir="$1"; shift
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    exitCode="0"
    # Body
    for moduleName in "${!MODULE_DIRS[@]}"; do
        waitForModuleExit "$moduleWorkdir" "$moduleName" &
        moduleByPID[$!]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in $(jobs -p); do
        wait "$jobPID" || {
            echo "Module '${moduleByPID[$jobPID]}' exited with exit code '$?'."
            exitCode="1"
        }
    done
    return "$exitCode"
}