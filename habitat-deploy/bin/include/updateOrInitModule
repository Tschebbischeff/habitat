#!/usr/bin/env bash

set -euo pipefail


# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"


# Include other Modules

include parseModuleInfo


# Public Variables

declare -gA MODULE_UPDATED


# Public Functions

updateOrInitModule() {
    # Args
    local moduleWorkdir moduleName updateAllowed
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    updateAllowed="$1"; shift
    # Vars
    local exitCode moduleRepo moduleDir
    exitCode="0"
    moduleRepo="${MODULE_REPOS[$moduleName]:-}"
    moduleDir="${MODULE_DIRS[$moduleName]:-}"
    { [ -n "$moduleRepo" ] && [ -n "$moduleDir" ]; } || { echo "Missing metadata for module '$moduleName'."; return 1; }
    # Body
    # shellcheck disable=SC2034  # Scoped outside included function
    MODULE_UPDATED[$moduleName]=""
    (
        cd "$moduleWorkdir"
        if [ -d "$moduleDir" ]; then
            if [ "$updateAllowed" == "yes" ]; then
                cd "$moduleDir"
                git fetch -p -q
                if [ "$(git rev-list "HEAD..@{u}" --count 2>/dev/null || echo 0)" -eq "0" ]; then
                    echo "No updates for '$moduleName' available."
                    exit 125
                else
                    if [ -n "$(git status --porcelain)" ]; then
                        echo "WARNING: Workdir dirty, not downloading the available update."
                        exit 2
                    else
                        echo "Downloading update for '$moduleName'..."
                        git pull
                    fi
                fi
            fi
        else
            echo "Initializing module '$moduleName'..."
            git clone "$moduleRepo" "$moduleDir"
        fi
    ) || exitCode="$?"
    # shellcheck disable=SC2034  # Scoped outside included function
    [ "$exitCode" -eq 0 ] && MODULE_UPDATED[$moduleName]="_"
    return "$exitCode"
}

updateOrInitModules() {
    # Args
    local moduleWorkdir updateAllowed
    moduleWorkdir="$1"; shift
    updateAllowed="$1"; shift
    declare -a moduleList
    while [ "$#" -gt 0 ]; do
        [ "$1" == "--" ] && break
        moduleList+=("$1")
        shift
    done
    if [[ ! -v "moduleList" ]]; then
        moduleList=("${!MODULE_DIRS[@]}")
    fi
    # Vars
    local exitCode moduleName jobPID jobReturnCode
    declare -A moduleByPID
    exitCode="0"
    # Body
    echo "Initializing/ Updating modules: $(printf "%s, " "${moduleList[@]}" | sed 's/, $//')"
    for moduleName in "${moduleList[@]}"; do
        MODULE_UPDATED[$moduleName]=""
        updateOrInitModule "$moduleWorkdir" "$moduleName" "$updateAllowed" &
        moduleByPID[$!]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in "${!moduleByPID[@]}"; do
        moduleName="${moduleByPID[$jobPID]}"
        jobReturnCode="0"
        wait "$jobPID" || jobReturnCode="$?"
        # shellcheck disable=SC2034  # Scoped outside included function
        [ "$jobReturnCode" -eq 0 ] && MODULE_UPDATED[$moduleName]="_"
        [ "$jobReturnCode" -eq 0 ] || [ "$jobReturnCode" -eq 125 ] || {
            echo "Updating or initializing '$moduleName' failed with exit code '$jobReturnCode'."
            exitCode="1"
        }
    done
    return "$exitCode"
}