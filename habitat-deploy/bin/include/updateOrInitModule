#!/usr/bin/env bash

set -euo pipefail

# Include File Header

[[ -v "HABITAT_INCLUDE[__main__]" ]] || { echo "Included file potentially executed directly. Bailing."; exit 1; }
[[ -v "HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]" ]] && return 0
HABITAT_INCLUDE[$(basename "${BASH_SOURCE[0]}" | tr '.-' '_')]="_"
echo "Loading '$(basename "${BASH_SOURCE[0]}")'..."

# Include other Modules

include parseModuleInfo

# Public Variables

declare -gA MODULE_UPDATED

# Public Functions

updateOrInitModule() {
    # Args
    local moduleWorkdir moduleName updateAllowed
    moduleWorkdir="$1"; shift
    moduleName="$1"; shift
    updateAllowed="$1"; shift
    # Vars
    local exitCode moduleRepoUrl moduleRepoDir
    exitCode="0"
    moduleRepoUrl="${MODULE_REPOS[$moduleName]}"
    moduleRepoDir="${MODULE_DIRS[$moduleName]}"
    # Body
    # shellcheck disable=SC2034  # Scoped outside included function
    MODULE_UPDATED[$moduleName]=""
    (
        cd "$moduleWorkdir"
        if [ -d "$moduleRepoDir" ]; then
            if [ "$updateAllowed" == "yes" ]; then
                cd "$moduleRepoDir"
                git fetch -p -q
                if [ "$(git rev-list "HEAD..@{u}" --count 2>/dev/null || echo 0)" -eq "0" ]; then
                    echo "No updates for '$moduleName' available."
                    exit 125
                else
                    if [ -n "$(git status --porcelain)" ]; then
                        echo "WARNING: Workdir dirty, not downloading the available update."
                        exit 2
                    else
                        echo "Downloading update for '$moduleName'..."
                        git pull
                    fi
                fi
            fi
        else
            echo "Initializing module '$moduleName'..."
            git clone "$moduleRepoUrl" "$moduleRepoDir"
        fi
    ) || exitCode="$?"
    # shellcheck disable=SC2034  # Scoped outside included function
    [ "$exitCode" -eq 0 ] && MODULE_UPDATED[$moduleName]="_"
    [ "$exitCode" -eq 125 ] && exitCode="0"
    return "$exitCode"
}

updateOrInitAllModules() {
    # Args
    local moduleWorkdir updateAllowed
    moduleWorkdir="$1"; shift
    updateAllowed="$1"; shift
    # Vars
    local exitCode moduleName jobPID
    declare -A moduleByPID
    exitCode="0"
    # Body
    for moduleName in "${!MODULE_DIRS[@]}"; do
        updateOrInitModule "$moduleWorkdir" "$moduleName" "$updateAllowed" &
        moduleByPID["$!"]="$moduleName"
    done
    # shellcheck disable=SC2046 # Word splitting intentional
    for jobPID in $(jobs -p); do
        wait "$jobPID" || {
            echo "Updating or initializing '${moduleByPID["$jobPID"]}' failed with exit code '$?'."
            exitCode="1"
        }
    done
    return "$exitCode"
}