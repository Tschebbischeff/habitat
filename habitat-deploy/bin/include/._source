#!/usr/bin/env bash

set -euo pipefail

[[ -v HABITAT_INCLUDE_MAIN ]] || {
    HABITAT_INCLUDE_MAIN="_"
    declare -gA HABITAT_INCLUDE
    # shellcheck disable=SC2034  # Checked within imported scripts
    HABITAT_INCLUDE[__main__]="_"
    # shellcheck disable=SC2034  # Checked within imported scripts
    HABITAT_WORKDIR="$(pwd)"
    cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"; cd ..
    # shellcheck disable=SC2009  # pgrep does not show arguments
    if ! grep -Pq '^[^ ]*/supervisor +[^ ]*' < <(tr '\0' ' ' < /proc/1/cmdline); then
        echo "Supervisor isn't running or not running as PID 1."
        exit 1
    fi
    # shellcheck disable=SC2034  # Checked within imported scripts
    # shellcheck disable=SC2009  # pgrep does not show arguments
    HABITAT_RUN_DIR="$(grep -Po '^[^ ]*/supervisor +\K[^ ]*' < <(tr '\0' ' ' < /proc/1/cmdline))"
}

include() {
    # Args
    local incName
    incName="$1"; shift
    # Body
    # shellcheck disable=SC1090  # Intended non-constant source
    . "./include/$incName" "$@"
}