#!/usr/bin/env bash

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/include/._source"


# ### Guard Clauses

[ "$$" -eq 1 ] || { echo "Supervisor should only be run as PID 1."; exit 1; }


# ### Includes

include containerStatus
include parseModuleInfo
include updateOrInitModule
include upgradeModule
include startModule
include stopModule
include hotswapWatcher
include waitExitModule


# ### Exit function

exitImmediately() {
    setContainerStatus "stopped"
    trap - SIGTERM
    [[ -v "2" ]] && [ -n "$2" ] && echo "$2"
    [[ -v "1" ]] && exit "$1"
    exit 0
}
# shellcheck disable=SC2329  # Gets used in trap
onTerminate() {
    trap '' SIGTERM
    setContainerStatus "stopping"
    echo "Exiting... Cleaning up..."
    if [ -n "$HOTSWAP_ENABLED" ]; then
        echo "Stopping watcher..."
        stopHotswapWatcher || true
        echo "Watcher stopped."
    fi
    echo "Stopping modules..."
    stopModules "$MODULE_DEPLOY_PATH" "$(( SHUTDOWN_TIMEOUT - 10 ))" || true
    echo "All modules stopped."
    echo "Stopping background tasks..."
    # shellcheck disable=SC2046 # Word splitting intentional
    kill $(jobs -p) || true
    echo "All background tasks stopped."
    exitImmediately 0 "Goodbye."
}
trap onTerminate SIGTERM

# ### Init
setContainerStatus "init"

parseModuleInfo "$MODULE_LIST" "$HOTSWAP_ENABLED"


# ### Clone and/or Update modules
setContainerStatus "update"

updateOrInitModules "$MODULE_DEPLOY_PATH" "$UPDATE_MODULES" || {
    echo "Some updates or initializations failed, see logs above."
    exit 1
}


# ### Pull and build if needed and/ or enabled
setContainerStatus "upgrade"

UPGRADE_MODULES_FORCE_BUILD="yes" # TODO: Remove when detection of needing a rebuild is more robust
upgradeModules "$MODULE_DEPLOY_PATH" "$UPGRADE_MODULES" "$UPGRADE_MODULES_FORCE_BUILD" "$UPGRADE_MODULES_SEQUENTIAL" || {
    echo "Some pull and/ or build operations failed, see logs above."
    exit 1
}


# ### Start modules
setContainerStatus "starting"

startModules "$MODULE_DEPLOY_PATH" || {
    echo "Some start operations failed, see logs above."
    exit 1
}


# ### Wait for containers to finish or for SIGTERM
setContainerStatus "started"

if [ "${MODULE_HOTSWAP_ENABLED[""]}" == "yes" ]; then
    startHotswapWatcher "$MODULE_DEPLOY_PATH"
fi
waitExitModules "$MODULE_DEPLOY_PATH" "5"
if [ "${MODULE_HOTSWAP_ENABLED[""]}" == "yes" ]; then
    stopHotswapWatcher
fi


# ### Exit
setContainerStatus "stopped"

exitImmediately 0 "All modules have exited."