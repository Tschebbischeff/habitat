#!/usr/bin/env bash

set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/include/._source"


# ### Guard Clauses

# [ -f "$HABITAT_RUN_DIR/APP_SESSION_ID.txt" ] || { echo "No APP_SESSION_ID found."; exit 1; }


# ### Includes

include containerStatus
include prepEnvironment
include parseModuleInfo
include updateOrInitModule
include upgradeModule
include startModule
include stopModule
include waitForModuleExit


# ### Init

parseModuleInfo "$MODULE_LIST"
# shellcheck disable=SC2155  # Return value is of no interest
export HABITAT_APP_MODULES="$(printf ',%s' "${!MODULE_REPOS[@]}" | grep -Po '^,\K.*')"
# shellcheck disable=SC2155  # Return value is of no interest
export HABITAT_APP_SESSION_ID="$(cat "/proc/sys/kernel/random/uuid")"


# ### Clone and/or Update modules

updateOrInitAllModules "$MODULE_DEPLOY_PATH" "$UPDATE_MODULES" || {
    echo "Some updates or initializations failed, see logs above."
    exit 1
}


# ### Pull and build if needed and/ or enabled

upgradeAllModules "$MODULE_DEPLOY_PATH" "$UPGRADE_MODULES" "$UPGRADE_MODULES_FORCE_BUILD" "$UPGRADE_MODULES_SEQUENTIAL" || {
    echo "Some pull and/ or build operations failed, see logs above."
    exit 1
}


# ### Start modules

startAllModules "$MODULE_DEPLOY_PATH" || {
    echo "Some start operations failed, see logs above."
    exit 1
}
